{
  "name": "utilitypilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/processors.test.mjs tests/prelaunch.test.mjs tests/new-tools.test.mjs tests/expansion.test.mjs tests/adsense.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "audit:site": "node scripts/audit.mjs",
    "check": "npm run test && npm run build && npm run audit:site",
    "audit:prelaunch": "node tests/prelaunch-browser.mjs",
    "audit:content": "node tests/seo-content-audit.mjs",
    "audit:history": "node tests/ahrefs-history-audit.mjs",
    "audit:new-tools": "node tests/new-tools-static.mjs && node tests/new-tools-browser.mjs",
    "audit:expansion": "node tests/expansion-browser.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "entities": "^8.1.0",
    "marked": "^18.0.14",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
