{
  "name": "utilitypilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/processors.test.mjs tests/prelaunch.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "audit:site": "node scripts/audit.mjs",
    "check": "npm run test && npm run build && npm run audit:site",
    "audit:prelaunch": "node tests/prelaunch-browser.mjs",
    "audit:content": "node tests/seo-content-audit.mjs",
    "audit:history": "node tests/ahrefs-history-audit.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "entities": "^8.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
